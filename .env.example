# Komodo writes these as Stack Environment variables; for local Compose copy to .env.
DOMAIN=openfront.viktorp04.com
SITE_HOST=openfront.viktorp04.com
LOCAL_ACCOUNT_ORIGIN=https://openfront.viktorp04.com
CLUSTER_JSON={"a":{"host":"openfront.viktorp04.com","color":"blue","numWorkers":2}}
OPENFRONT_BIND_ADDRESS=127.0.0.1
OPENFRONT_PORT=8080
OPENFRONT_ACCOUNTS_VOLUME=openfront-accounts

# Optional: supply a long random PRIVATE code to restrict new accounts to friends.
LOCAL_ACCOUNT_REGISTRATION_CODE=
# These external/admin integrations stay disabled/unconfigured by default.
API_KEY=
ADMIN_BOT_API_KEY=
STRIPE_PUBLISHABLE_KEY=
CDN_BASE=
ALLOWED_FLARES=

# No Turnstile verification in account mode; this only satisfies the app bootstrap.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Leave unset for the pre-deploy hook to supply the checked-out commit automatically.
# GIT_COMMIT=

# Optional public account API base URL and JWT issuer. Blank preserves defaults.
# Local accounts must stay at LOCAL_ACCOUNT_ORIGIN/api/accounts (same-origin cookies).
API_ORIGIN=
AUTH_ISSUER=
